//Bibliotecas
#INCLUDE "TOTVS.CH"
     
/*/{Protheus.doc} User Function LIBCRE01
@type Function
@author luciano
@since 22/10/2025
@obs   LEGENDA DO CAMPO C9_BLCRED 
/*/

USER FUNCTION LIBCRE01(CPEDIDO,CITEM)
	
	Local aArea    := GetArea()
	LOCAL CMOTIVO  := ""
    LOCAL XRECSC9  := SC9->(RECNO())
    LOCAL XORDSC9  := SC9->(INDEXORD())
	Local aAreaSB2 := SB2->(GetArea()) //Ticket BRSM-4318

    IF EMPTY(CPEDIDO) .OR. EMPTY(CITEM)
       RETURN ""
    ENDIF

	DBSELECTAREA("SC9")
	DBSETORDER(1)
	DBSEEK(XFILIAL("SC9")+CPEDIDO+CITEM+"99",.T.)
    IF SC9->C9_PEDIDO+SC9->C9_ITEM <> CPEDIDO+CITEM
       DBSKIP(-1)
    ENDIF 
	
	//Ticket BRSM-4318 - Begin
	DBSELECTAREA("SB2")
	DBSETORDER(1)
	//Ticket BRSM-4318 - End

	IF SC9->C9_PEDIDO+SC9->C9_ITEM == CPEDIDO+CITEM

		IF EMPTY(SC9->C9_BLCRED)
			CMOTIVO  := "SEM BLOQUEIO FIN"
		ENDIF
		IF ALLTRIM(SC9->C9_BLCRED) == "01"
			CMOTIVO  := "BLOQUEIO POR VALOR"
		ENDIF	

		//Ticket BRSM-4318 - Begin
		If MsSeek(xFilial("SB2")+SC9->(C9_PRODUTO+C9_LOCAL))

			IF ALLTRIM(SC9->C9_BLCRED) == "02" .AND. ALLTRIM(SB2->B2_DTINV) == '' 
				CMOTIVO := "BLOQUEIO POR ESTOQUE"
			ENDIF		

			IF ALLTRIM(SC9->C9_BLCRED) == "02" .AND. ALLTRIM(SB2->B2_DTINV) <> '' 
				CMOTIVO := "BLOQUEIO POR INVENTARIO"
			ENDIF
		EndIf
		//Ticket BRSM-4318 - End
		
		IF ALLTRIM(SC9->C9_BLCRED) == "04"
			CMOTIVO := "LIMITE CREDITO VENCIDO"
		ENDIF
		IF ALLTRIM(SC9->C9_BLCRED) == "09"
			CMOTIVO := "LIB CREDITO REJEITADA"
		ENDIF
		IF ALLTRIM(SC9->C9_BLCRED) == "ZZ"
			CMOTIVO := "LIB TARDIA"
		ENDIF

	ENDIF

    DBSELECTAREA("SC9")
    DBSETORDER(XORDSC9)
    GO XRECSC9
	
	RestArea(aAreaSB2) //Ticket BRSM-4318	
	RestArea(aArea)

RETURN CMOTIVO
